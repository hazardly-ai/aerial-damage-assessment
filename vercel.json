{
	"version": 2,
	"builds": [
		{
			"src": "backend/app/app.py",
			"use": "@vercel/python"
		},
		{
			"src": "frontend/package.json",
			"use": "@vercel/static-build",
			"config": { "distDir": "dist" }
		}
	],
	"routes": [
		{
			"src": "/api/(.*)",
			"dest": "/backend/app/app.py"
		},
		{
			"src": "/assets/(.*)",
			"dest": "/frontend/assets/$1"
		},
		{
			"src": "/(.*)",
			"dest": "/frontend/index.html"
		}
	]
}
